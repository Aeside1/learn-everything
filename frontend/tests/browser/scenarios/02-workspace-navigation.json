    },
    {
      "name": "workspace-loading-and-error",
      "steps": [
        { "goto": "/" },
        { "setApiDelay": 1200 },
        { "reload": true },
        { "screenshot": { "name": "workspace-loading-state" } },
        { "setApiDelay": 0 },
        { "wait": 1500 },
        { "setApiError": "GET /api/v1/projects/\\d+/roadmap" },
        { "reload": true },
        { "expectVisible": { "role": "button", "name": "重新加载" } },
        { "expectVisible": { "role": "alert" } },
        {
          "screenshot": {
            "name": "workspace-error-state",
            "verify": [{ "role": "button", "name": "重新加载" }]
          }
        },
        { "setApiError": null },
        { "click": { "role": "button", "name": "重新加载" } },
        {
          "screenshot": {
            "name": "workspace-error-recovered",
            "verify": [
              { "role": "progressbar", "name": "学习进度" },
              { "role": "tab", "name": "学习概览" }
            ]
          }
        }
      ]
    }
