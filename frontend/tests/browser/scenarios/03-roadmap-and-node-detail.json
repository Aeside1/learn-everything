        { "setApiError": null },
        { "click": { "role": "button", "name": "保存笔记" } },
        { "expectEnabled": { "role": "button", "name": "保存笔记" } },
        {
          "screenshot": {
            "name": "node-detail-note-recovered",
            "verify": [
              { "role": "textbox", "name": "学习笔记" },
              { "role": "button", "name": "拉取资料" }
            ]
          }
        },
        { "click": { "role": "button", "name": "拉取资料" } },
        { "expectVisible": { "role": "link", "name": "Rust Book" } },
        {
          "screenshot": {
            "name": "node-detail-resources",
            "verify": [
              { "role": "link", "name": "Rust Book" },
              { "role": "button", "name": "拉取资料" }
            ]
          }
        },
        { "click": { "role": "button", "name": "返回学习路线" } },
        { "expectVisible": { "role": "button", "name": "查看 生命周期与借用检查器 的详细内容" } },
        { "screenshot": { "name": "roadmap-returned-to-list", "verify": [{ "role": "tab", "name": "学习路线" }] } }
      ]
