    {
      "name": "roadmap-node-list-status-and-detail-actions",
      "viewport": { "width": 1280, "height": 900 },
      "steps": [
        { "goto": "/" },
        { "click": { "role": "tab", "name": "学习路线" } },
        { "expectSelected": { "role": "tab", "name": "学习路线" } },
        { "expectChecked": { "role": "radio", "name": "已掌握", "checked": true } },
        { "expectChecked": { "role": "radio", "name": "待开始", "checked": false } },
        { "hover": { "role": "radio", "name": "需复习" } },
        {
          "screenshot": {
            "name": "roadmap-node-list-status",
            "verify": [
              { "role": "tab", "name": "学习路线" },
              { "role": "button", "name": "查看 所有权与借用 的详细内容" },
              { "role": "radio", "name": "已掌握" },
              { "role": "radio", "name": "待开始" }
            ]
          }
        },
        { "focus": { "role": "radio", "name": "待开始" } },
        { "expectFocus": { "name": "待开始" } },
        { "screenshot": { "name": "roadmap-status-focus", "verify": [{ "role": "radio", "name": "待开始" }] } },
        { "setApiDelay": 1500 },
        { "click": { "role": "radio", "name": "需复习" } },
        { "expectDisabled": { "role": "radio", "name": "需复习" } },
        { "expectDisabled": { "role": "radio", "name": "待开始" } },
        { "screenshot": { "name": "roadmap-status-pending", "verify": [{ "role": "radio", "name": "需复习" }] } },
        { "wait": 2000 },
        { "setApiDelay": 0 },
        { "expectChecked": { "role": "radio", "name": "需复习", "checked": true } },
        { "expectEnabled": { "role": "radio", "name": "待开始" } },
        { "setApiError": "PATCH /api/v1/nodes/\\d+/status" },
        { "click": { "role": "radio", "name": "学习中" } },
        { "wait": 600 },
        { "expectChecked": { "role": "radio", "name": "需复习", "checked": true } },
        { "screenshot": { "name": "roadmap-status-rollback", "verify": [{ "role": "radio", "name": "需复习" }] } },
        { "setApiError": null },
        { "click": { "role": "button", "name": "查看 所有权与借用 的详细内容" } },
        { "expectVisible": { "role": "heading", "name": "所有权与借用" } },
        { "expectChecked": { "role": "radio", "name": "需复习", "checked": true } },
        { "fill": { "role": "textbox", "name": "学习笔记", "value": "借用检查器要点：同一作用域内只能有一个可变借用。" } },
        {
          "screenshot": {
            "name": "node-detail-note-draft",
            "verify": [
              { "role": "heading", "name": "所有权与借用" },
              { "role": "textbox", "name": "学习笔记" },
              { "role": "button", "name": "返回学习路线" }
            ]
          }
        },
        { "expectVisible": { "role": "textbox", "name": "学习笔记" } },
        { "focus": { "role": "button", "name": "重新生成课程" } },
        { "expectFocus": { "name": "重新生成课程" } },
        {
          "screenshot": {
            "name": "node-detail-action-focus",
            "verify": [
              { "role": "button", "name": "重新生成课程" },
              { "role": "button", "name": "拉取资料" }
            ]
          }
        },
        { "setApiDelay": 1500 },
        { "click": { "role": "button", "name": "重新生成实操" } },
        { "expectText": "正在生成实操课程…" },
        { "expectDisabled": { "role": "button", "name": "保存笔记" } },
        { "expectDisabled": { "role": "button", "name": "拉取资料" } },
        {
          "screenshot": {
            "name": "node-detail-action-loading",
            "verify": [
              { "role": "button", "name": "重新生成实操" },
              { "role": "textbox", "name": "学习笔记" }
            ]
          }
        },
        { "wait": 2000 },
        { "setApiDelay": 0 },
        { "expectEnabled": { "role": "button", "name": "保存笔记" } },
        { "setApiError": "PUT /api/v1/nodes/\\d+/note" },
        { "click": { "role": "button", "name": "保存笔记" } },
        { "expectText": "验收模拟的服务端错误" },
        {
          "screenshot": {
            "name": "node-detail-note-error",
            "verify": [
              { "role": "textbox", "name": "学习笔记" },
              { "role": "button", "name": "保存笔记" },
              { "role": "button", "name": "返回学习路线" }
            ]
