        { "expectText": "遇到 Err 时提前返回该错误" },
        { "click": { "role": "button", "name": "简单" } },
        { "expectText": "当前没有到期卡片。" },
        {
          "screenshot": {
            "name": "review-empty-queue",
            "verify": [
              { "role": "tab", "name": "到期复习" },
              { "role": "heading", "name": "到期复习" }
            ]
          }
        }
