    {
      "name": "dashboard-loading-error-retry",
      "viewport": { "width": 1280, "height": 900 },
      "steps": [
        { "goto": "/" },
        { "expectText": "185" },
        { "setApiDelay": 2500 },
        { "click": { "role": "button", "name": "刷新学习看板" } },
        { "expectVisible": { "role": "button", "name": "刷新学习看板" } },
        {
          "screenshot": {
            "name": "dashboard-loading",
            "verify": [
              { "role": "tab", "name": "学习概览" },
              { "role": "heading", "name": "学习概览" }
            ]
          }
        },
        { "setApiDelay": 0 },
        { "wait": 2600 },
        { "setApiError": "GET /api/v1/projects/\\d+/dashboard" },
        { "click": { "role": "button", "name": "刷新学习看板" } },
        { "expectVisible": { "role": "alert" } },
        { "expectText": "验收模拟的服务端错误" },
        {
          "screenshot": {
            "name": "dashboard-error",
            "probeOverlays": false,
            "verify": [
              { "role": "tab", "name": "学习概览" },
              { "role": "button", "name": "重试" }
            ]
          }
        },
        { "setApiError": null },
        { "click": { "role": "button", "name": "重试" } },
        { "expectText": "185" },
        {
          "screenshot": {
            "name": "dashboard-error-recovered",
            "verify": [
              { "role": "tab", "name": "学习概览" },
              { "role": "button", "name": "刷新学习看板" }
            ]
          }
        }
      ]
    },
    {
