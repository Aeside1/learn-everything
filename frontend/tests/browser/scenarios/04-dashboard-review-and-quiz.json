        { "expectEnabled": { "role": "button", "name": "良好" } },
        {
          "screenshot": {
            "name": "review-next-card",
            "verify": [
              { "role": "tab", "name": "到期复习" },
              { "role": "button", "name": "重来" },
              { "role": "button", "name": "查看答案" }
