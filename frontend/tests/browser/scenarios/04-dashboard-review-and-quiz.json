        { "setApiDelay": 6000 },
        { "click": { "role": "button", "name": "良好" } },
        { "expectDisabled": { "role": "button", "name": "良好" } },
        { "expectDisabled": { "role": "button", "name": "简单" } },
        { "expectText": "正在提交评分" },
        {
          "screenshot": {
            "name": "review-submitting",
