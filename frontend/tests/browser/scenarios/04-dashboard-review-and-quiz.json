        { "expectText": "export roadmap" },
        { "goto": "/" },
        { "click": { "role": "button", "name": "学习笔记" } },
        { "expectText": "export markdown" },
        { "goto": "/" },
        { "click": { "role": "button", "name": "进度报告 HTML" } },
        { "expectText": "export report" },
        { "goto": "/" },
        { "click": { "role": "button", "name": "Anki ZIP" } },
