        { "expectInViewport": { "role": "textbox", "name": "学习笔记" } },
        { "screenshot": { "name": "lesson-table-narrow", "verify": [{ "role": "textbox", "name": "学习笔记" }] } },
        { "viewport": { "width": 420, "height": 860 } },
        { "wheelTo": { "role": "textbox", "name": "学习笔记" } },
        { "expectInViewport": { "role": "textbox", "name": "学习笔记" } },
        { "expectText": "多线程执行器" },
        { "screenshot": { "name": "lesson-table-420", "verify": [{ "role": "textbox", "name": "学习笔记" }] } }
      ]
    },
    {
